# ======================================================
# 1. Telegram Bot Token (From @BotFather on Telegram)
# ======================================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram User ID (Optional - so only you can use this bot)
# Leave blank to allow anyone who messages the bot
ALLOWED_USER_IDS=

# ======================================================
# 2. Google Gemini AI API Key (Free from aistudio.google.com)
# ======================================================
GEMINI_API_KEY=AIzaSy...

# ======================================================
# 3. Meta Graph API (Facebook Page & Instagram)
# ======================================================
# Long-lived Page Access Token from developers.facebook.com
META_ACCESS_TOKEN=EAAG...
# Numeric Facebook Page ID (e.g., BANNI Tech page ID)
FACEBOOK_PAGE_ID=100000000000000
# Numeric Instagram Business Account ID
INSTAGRAM_ACCOUNT_ID=17841400000000000

# ======================================================
# 4. YouTube Shorts (Data API v3)
# ======================================================
# Download client_secrets.json from Google Cloud Console into this directory
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
